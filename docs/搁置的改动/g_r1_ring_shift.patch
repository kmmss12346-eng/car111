+    def _ring_shift(self, ring):
+        """(10-29 用户"这个1号环我想改成g R1 -5 -5")rfine off 时 1、3 号环按 arm_calib 调的角度放，不看这个环自己的十字：
+        g R1 / g R3 挪过多少像素(vision_cal.json 的 ring_shift_px，主程序 g 挪十字时累计)按画面和手臂的对应关系(RING 的手臂 J)
+        换成手臂多转多少度 —— 和 rfine on 时十字挪这么多、摄像头对准后手臂停的地方一样。返回 (ID1 度, ID2 度, (du, dv))；
+        没挪过、没有 J 返回 None。"""
+        if int(ring) == 2:
+            return None
+        k = f'RING{int(ring)}'
+        try:
+            sh = (load_vision_cal(self.cfg.get('vision_cal_file')).get('ring_shift_px') or {}).get(k)
+            du, dv = (float(sh[0]), float(sh[1])) if sh else (0.0, 0.0)
+        except (TypeError, ValueError, IndexError):
+            du, dv = 0.0, 0.0
+        if abs(du) < 1e-6 and abs(dv) < 1e-6:
+            return None
+        J = self.store.get('RING', 'arm') if self.store is not None else None
+        if J is None:
+            if not getattr(self, '_ring_shift_said', False):
+                self._ring_shift_said = True
+                self.log(f'    ★ g R{int(ring)} 挪过 {du:+g}, {dv:+g} 像素，但还没有画面和手臂的对应关系(vcal RING arm)：这次不按它挪')
+            return None
+        try:
+            d = np.linalg.solve(np.asarray(J, float), np.array([du, dv]))     # 十字挪 (du, dv)：圆环在画面里要停在挪过的地方
+        except np.linalg.LinAlgError:
+            return None
+        return float(d[1]), float(d[0]), (du, dv)                              # J 的两列是 (ID2, ID1)
+
