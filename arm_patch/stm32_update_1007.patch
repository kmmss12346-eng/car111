+    }
+    FmtF(s1, (int)sizeof(s1), lift_enc0);
+    FmtF(s2, (int)sizeof(s2), lift_cpm);
+    snprintf(m, sizeof(m), "LIFTCAL OK ENC0=%s CPM=%s CPR=%ld SRC=%02X\r\n", s1, s2, (long)cpr, (unsigned)lift_src);
+    Say(m);
+    return NULL;
+}
