+            ok = 0;
+        }
+    }
+    HAL_FLASH_Lock();
+    pos_last_ok = 0;                               /* 扇区擦掉了，位置记录也没了 */
+    if (ok)
+    {
+        Cal_Load();                                /* 读回来校验 */
+        ok = lift_cal_ok;
+    }
+    return ok;
+}
