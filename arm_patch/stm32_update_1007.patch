+                }
+                *v = (uint16_t)(p & 0xFFFFu);
+                return 1;
+            }
+        }
+        else if (Car_Motor_Query(LIFT_ADDR, 0x31, r, 5))
+        {
+            *v = (uint16_t)(((uint16_t)r[2] << 8) | r[3]);
