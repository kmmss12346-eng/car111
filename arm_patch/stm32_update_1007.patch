+/* 用编码器算现在的高度：在 near_mm 上下半圈(±20mm)以内找。没标定或读不到返回 0 */
+static int Lift_EncPos(float near_mm, float *z, uint16_t *raw)
+{
+    uint16_t e;
+    float rev;
